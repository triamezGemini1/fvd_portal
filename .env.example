# Desarrollo local (WAMP). Copiar a .env en la raíz del proyecto.
# Producción (hosting): usar .env.production.example como referencia.
#
APP_NAME="FVD Portal"
APP_ENV=development
APP_DEBUG=true
APP_BASE_PATH=/fvd_portal
APP_TIMEZONE=America/Caracas

# Panel maestro (Vite): en local use el bundle compilado (npm run build). Solo ponga true si ejecuta `npm run dev`.
FVD_VITE_DEV=false
# FVD_VITE_DEV_SERVER=http://127.0.0.1:5173

# Copia duplicada / entorno que no debe usarse: ponga true solo en el .env de ESA carpeta (no en producción oficial).
# APP_DEPLOYMENT_DISABLED=false
# URL del sitio bueno (opcional, enlace en la página 503):
# APP_DEPLOYMENT_CANONICAL_URL=https://ejemplo.com/fvd_portal/

# Diagnóstico: con APP_DEBUG=true abra en el navegador /fvd_diag.php (raíz del proyecto) para ver qué carpeta sirve PHP.
# Sin APP_DEBUG: FVD_DIAG_SECRET=clave_larga  y  /fvd_diag.php?key=clave_larga

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fvdmasteradmin
DB_USERNAME=root
DB_PASSWORD=
